# Aquifer under the soak supervisor (for RSS, goroutine and fd stats on
# :9090). Build from the repository root.
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o aquifer ./cmd/aquifer && go build -o supervisor ./benchmark/soak/supervisor

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /app/aquifer /app/supervisor ./
ENV AQUIFER_ADAPTER=http PORT=8080 DB_PATH=/tmp/aquifer.db L8_KEY_PATH=/tmp/l8-key \
    AQUIFER_DEBUG_ADDR=127.0.0.1:6060
CMD ["/app/supervisor", "-cmd", "/app/aquifer", "-data", "/tmp"]

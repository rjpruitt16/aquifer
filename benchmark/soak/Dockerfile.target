# Aquifer under the soak supervisor, with a local Valkey for WebSocket
# transcripts. Build from the repository root:
#   fly deploy -c benchmark/soak/fly.target.toml --dockerfile benchmark/soak/Dockerfile.target
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o aquifer ./cmd/aquifer && go build -o supervisor ./benchmark/soak/supervisor

FROM alpine:3.22
RUN apk add --no-cache ca-certificates valkey
WORKDIR /app
COPY --from=builder /app/aquifer /app/supervisor ./
COPY benchmark/soak/aquifer-soak.yml ./aquifer-soak.yml
COPY benchmark/soak/target-start.sh ./target-start.sh
ENV AQUIFER_ADAPTER=http \
    PORT=8080 \
    DB_PATH=/data/aquifer.db \
    L8_KEY_PATH=/data/l8-key \
    CONFIG_PATH=/app/aquifer-soak.yml \
    AQUIFER_DEBUG_ADDR=127.0.0.1:6060
CMD ["/app/target-start.sh"]

# Soak driver. Build from the repository root:
#   fly deploy -c benchmark/soak/fly.driver.toml --dockerfile benchmark/soak/Dockerfile.driver
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o driver ./benchmark/soak/driver

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /app/driver /driver
ENTRYPOINT ["/driver", "-data", "/data"]

# Driver for the cluster failure test: the soak driver plus the Valkey the
# Aquifer nodes coordinate through, so a scenario can take Valkey down.
# Build from the repository root:
#   fly deploy -c benchmark/soak/fly.cluster-driver.toml --dockerfile benchmark/soak/Dockerfile.cluster-driver
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o driver ./benchmark/soak/driver

FROM alpine:3.22
RUN apk add --no-cache ca-certificates valkey
COPY --from=builder /app/driver /driver
# Every open request and every webhook coming back is an open file. A
# backlog clearing at once needs more than Fly's default of 10,240; past
# it the driver can't connect, which it counts as client errors.
ENTRYPOINT ["sh", "-c", "ulimit -n 1048576 2>/dev/null || ulimit -n 65536 2>/dev/null; exec /driver \"$@\"", "driver"]
